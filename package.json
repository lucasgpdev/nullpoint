{
  "name": "nullpoint",
  "private": true,
  "version": "0.1.0",
  "description": "NULLPOINT — FPS 3D multiplayer competitivo no navegador",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "npm run dev -w @nullpoint/server",
    "dev:client": "npm run dev -w @nullpoint/client",
    "build": "npm run build -w @nullpoint/client && npm run build -w @nullpoint/server",
    "start": "node server/dist/index.js",
    "typecheck": "tsc -p shared --noEmit && tsc -p server --noEmit && tsc -p client --noEmit",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/two-browsers.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "playwright": "^1.63.0",
    "socket.io-client": "^4.8.4",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module"
}
